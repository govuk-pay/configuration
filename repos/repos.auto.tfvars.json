{
  "repos": {
    "configuration": {
      "visibility": "public",
      "description": "Infrastructure-as-code for the GOV.UK Pay GitHub organisation"
    },
    "pay-access-control": {
      "visibility": "private",
      "description": "Canonical record of access permissions on GOV.UK Pay",
      "push_teams": [
        "team-payments",
        "team-payments-documentation"
      ]
    },
    "pay-apple-developer-agreements": {
      "visibility": "private",
      "description": "This repository is for GOV.UK Pay to store and track changes to the Apple Developer Agreement terms and conditions."
    },
    "pay-architecture": {
      "visibility": "internal",
      "description": "GOV.UK Pay architecture documentation",
      "has_discussions": true,
      "allow_push_to_main": true
    },
    "pay-perftests": {
      "visibility": "private",
      "default_branch": "master",
      "description": "GOV.UK Pay Performance Tests"
    },
    "pay-product-page": {
      "visibility": "public",
      "description": "GOV.UK Pay product page",
      "push_teams": [
        "team-payments",
        "team-payments-documentation"
      ]
    },
    "pay-run-amock": {
      "visibility": "public",
      "description": "A replacement for Mountebank in the tests for GOV.UK Pay"
    },
    "pay-scripts": {
      "visibility": "private",
      "default_branch": "master",
      "description": "Dev tooling and build scripts"
    },
    "pay-selfservice-policy-docs": {
      "visibility": "private"
    },
    "pay-set-up-pre-commit": {
      "visibility": "public",
      "description": "Script used to install `pre-commit` on all local `pay` Git repos.  This will make sure that the `pre-commit` Git hooks run whenever you try to commit a file."
    },
    "pay-stubs": {
      "visibility": "private",
      "default_branch": "master",
      "description": "Stubs for our payment gateways"
    },
    "pay-team-manual": {
      "visibility": "internal",
      "default_branch": "master",
      "description": "GOV.UK Pay team manual",
      "push_teams": [
        "team-payments",
        "team-payments-documentation"
      ]
    },
    "pay-tech-docs": {
      "visibility": "public",
      "description": "Technical documentation for GOV.UK Pay",
      "push_teams": [
        "team-payments",
        "team-payments-documentation"
      ]
    }
  }
}
